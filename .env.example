# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token có quyền ghi (Editor) - CHỈ dùng phía server, không đặt tiền tố NEXT_PUBLIC_
SANITY_API_TOKEN=
# Bí mật cho webhook Sanity -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# Origin công khai của site (không có dấu / cuối), dùng cho canonical, og:url, sitemap
NEXT_PUBLIC_SITE_URL=https://example.com

# Link Messenger của fanpage (vd. https://m.me/ten-trang). Bỏ trống thì ẩn nút Messenger.
NEXT_PUBLIC_MESSENGER_URL=
# Địa chỉ trụ sở hiển thị ở trang liên hệ. Bỏ trống thì ẩn dòng địa chỉ.
NEXT_PUBLIC_ADDRESS=
